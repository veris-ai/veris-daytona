{
  "name": "@veris-ai/daytona-opencode",
  "version": "0.1.0",
  "description": "Run every OpenCode session in a Daytona sandbox whose vendor API calls are answered by a Veris twin. One line in opencode.json: unmodified code, real hostnames, and a receipt of what the vendor actually received.",
  "main": "./.opencode/plugin/index.js",
  "types": "./.opencode/plugin/index.d.ts",
  "files": [
    ".opencode",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/veris-ai/plugins.git",
    "directory": "daytona-opencode"
  },
  "author": "Veris (https://veris.ai)",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/veris-ai/plugins/issues"
  },
  "homepage": "https://github.com/veris-ai/plugins/tree/main/daytona-opencode#readme",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "veris",
    "daytona",
    "sandbox",
    "integration-testing"
  ],
  "engines": {
    "opencode": ">=1.16 <2"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@veris-ai/daytona": "^0.1.0",
    "@daytona/sdk": "^0.204.1",
    "@opencode-ai/plugin": "1.1.59",
    "xdg-basedir": "^5.1.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5.6.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
